# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Channel3 product search (trychannel3.com/developers, promo PAYPAL-HACKATHON-2026)
# Leave empty to use the built in demo catalog.
CHANNEL3_API_KEY=

# Groq LLM (console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Safety rules, enforced in code
DAILY_SPEND_CAP=150
FAMILY_APPROVAL_OVER=50
MAX_QUANTITY=5
PRICE_GUARD_RATIO=1.5

# true adds one clearly labelled fake malicious listing for the demo
DEMO_INJECTION=false
